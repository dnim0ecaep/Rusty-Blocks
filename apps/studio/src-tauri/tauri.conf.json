{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WarpForge Studio",
  "version": "0.1.0",
  "identifier": "com.warpforge.studio",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter @warpforge/studio dev",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @warpforge/studio build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "WarpForge Studio",
        "width": 1500,
        "height": 980,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
